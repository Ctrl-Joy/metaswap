{
  "name": "metaswap",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/sdk"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:chain": "node scripts/dev.mjs --chain-only",
    "contracts:build": "cd packages/contracts && forge build",
    "contracts:test": "cd packages/contracts && forge test",
    "sdk:sync": "node packages/sdk/scripts/sync.mjs",
    "test:sdk": "npm test -w @metaswap/sdk"
  }
}
